package kr.partix.kernel.boxes;

import lang.partic.stdlib.core.Object;
import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.additional.utils.StrUtils;

class IntegerBox {
    private final int boxed;

    IntegerBox(int boxed) {
        this.boxed = boxed;
    }

    boolean equals(Object o) {
        if (o instanceof IntegerBox) {
            IntegerBox integerBox = (IntegerBox) o;
            if (integerBox.getBoxed() == boxed) return true;
        }
        return false;
    }

    int hashCode() -> boxed

    str toStr() {
        StrBuilder strBuilder = new StrBuilder();
        strBuilder.append("[Boxed Integer: ");
        strBuilder.append(StrUtils.toDec(boxed));
        strBuilder.append("]");
        str builded = strBuilder.build();
        strBuilder.dispose();
        return builded;
    }

    int getBoxed() -> boxed
}