package kr.partix.kernel.event;

import lang.partic.stdlib.additional.collection.map.Map;
import lang.partic.stdlib.additional.collection.map.HashMap;
import lang.partic.stdlib.additional.collection.list.ArrayList;
import lang.partic.stdlib.additional.collection.list.List;
import lang.partic.stdlib.core.memory.Memory;
import kr.partix.kernel.exception.NotInitializedException;
import kr.partix.kernel.boxes.IntegerBox;

class EventBus {
    private volatile static boolean inited = false;
    private static Map<IntegerBox, List<IEventListener>> eventListeners; // TODO: 如果未来加入了多核，则需自行实现 ConcurrentHashMap
    private EventBus() {}

    static void init() {
        eventListeners = new HashMap<IntegerBox, List<IEventListener>>();
        inited = true;
    }

    static void registerEventListener(int eventId, IEventListener listener) {
        if (!inited) throw new NotInitializedException("EventBus not initialized!", null);
        List<IEventListener> eventListenerList = eventListeners.get(new IntegerBox(eventId));
        if (eventListenerList != null) {
            eventListenerList.add(listener);
        } else {
            List<IEventListener> list = new ArrayList<IEventListener>(); // TODO: 同上，未来需要线程安全
            list.add(listener);
            List<IEventListener> listReplaced = eventListeners.put(new IntegerBox(eventId), list);
            if (listReplaced != null) {
                // 有被替换掉的旧值就free掉
                Memory.free((long) listReplaced);
            }
        }
    }

    /**
     * 反注册监听器（如设备拆除时摘掉对应监听器）；返回是否移除成功。
     * 列表空后把整个事件 ID 的条目从表中移除。
     */
    static boolean unregisterEventListener(int eventId, IEventListener listener) {
        if (!inited) throw new NotInitializedException("EventBus not initialized!", null);
        if (listener == null) return false;
        IntegerBox key = new IntegerBox(eventId);
        List<IEventListener> eventListenerList = eventListeners.get(key);
        boolean removed = false;
        if (eventListenerList != null) {
            IEventListener old = eventListenerList.remove(listener);
            removed = old != null;
            if (removed && eventListenerList.isEmpty()) {
                // 列表空了：整条移除并回收空列表对象
                List<IEventListener> evicted = eventListeners.remove(key);
                if (evicted != null) Memory.free((long) evicted);
            }
        }
        Memory.free((long) key);
        return removed;
    }

    static void call(AEvent event) {
        if (!inited) throw new NotInitializedException("EventBus not initialized!", null);
        if (event != null) {
            IntegerBox key = new IntegerBox(event.getEventId());
            List<IEventListener> eventListenerList = eventListeners.get(key);
            Memory.free((long) key);   // get() 只用 key 比较，不持有
            if (eventListenerList != null) {
                for (int i = 0; i < eventListenerList.size(); i++) {
                    eventListenerList.get(i).onEvent(event);
                }
            }
        }
    }

    static void dispose() {
        eventListeners.disposeAll();
        inited = false;
    }
}