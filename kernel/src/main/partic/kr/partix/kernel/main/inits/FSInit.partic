package kr.partix.kernel.main.inits;

import kr.partix.kernel.fs.fat32.Fat32;
import kr.partix.kernel.fs.vfs.DEntry;
import kr.partix.kernel.fs.vfs.FileMode;
import kr.partix.kernel.fs.vfs.INode;
import kr.partix.kernel.fs.vfs.MountTable;
import kr.partix.kernel.fs.vfs.VFS;
import kr.partix.kernel.io.disk.DiskRegistry;
import kr.partix.kernel.io.disk.IDisk;
import kr.partix.kernel.io.disk.PartitionDisk;
import kr.partix.kernel.elf.ELF;
import kr.partix.kernel.elf.ELFSegment;
import kr.partix.kernel.elf.ELFSection;
import kr.partix.kernel.log.StartupLogger;
import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.additional.utils.StrUtils;
import lang.partic.stdlib.core.memory.Memory;

/**
 * 文件系统初始化：遍历所有盘的所有分区，按 FAT32 卷标匹配挂载点
 * （类似 Linux fstab，label → 挂载路径）：
 *   ESP  → /     （引导分区兼作根：KERNEL.ELF 在根上）
 *   DATA → /data （数据分区）
 * /bin 不是挂载点——用户程序放在根分区的 bin/ 真实目录里（VFS 树形解析）。
 * 无卷标匹配的 FAT32 分区跳过并打日志。
 */
class FSInit {
    static void init() {
        if (DiskRegistry.getCount() == 0) {
            StartupLogger.warn("no disk available, filesystem skipped");
            return;
        }
        mountByLabel();
        listMount("/");
        listMount("/bin");
        listMount("/data");
        verifyKernel();
    }

    /** 遍历所有盘的所有分区，识别 FAT32 并按卷标挂载。 */
    private static void mountByLabel() {
        int disks = DiskRegistry.getCount();
        for (int i = 0; i < disks; i++) {
            IDisk raw = DiskRegistry.get(i);
            if (raw == null) continue;

            PartitionDisk[] parts = PartitionDisk.findAll(raw);
            if (parts == null) {
                // 无 GPT：回退整盘尝试（旧 superfloppy 镜像）
                tryMount(raw, raw);
                continue;
            }
            for (int j = 0; j < parts.length; j++) {
                if (parts[j] == null) continue;
                if (!tryMount(raw, parts[j])) {
                    // 挂载失败（非 FAT32 / 无匹配挂载点）：分区视图不再被引用，释放
                    Memory.free((long) parts[j]);
                }
            }
            Memory.free((long) parts);
        }
    }

    /** 尝试把 view（整盘或分区）作为 FAT32 挂载；返回是否成功。 */
    private static boolean tryMount(IDisk raw, IDisk view) {
        Fat32 fat = new Fat32(view);
        if (!fat.isValid()) return false;
        str label = fat.getVolumeLabel();
        str path = mountPathFor(label);
        if (path == null && !isMounted("/")) {
            // 兜底：卷标未匹配（NO NAME/空/工具只写根目录条目等）时，
            // 第一个 FAT32 分区直接作根。免疫卷标问题；已挂过 / 则跳过。
            path = "/";
        }
        if (path == null) {
            StrBuilder sb = new StrBuilder();
            sb.append("filesystem: skip FAT32 (label=");
            sb.append(label);
            sb.append(", no mount path)");
            log(sb);
            Memory.free(label);
            return false;
        }
        int rc = VFS.mount(path, view, fat);
        if (rc == 0) {
            StrBuilder sb = new StrBuilder();
            sb.append("filesystem: FAT32 mounted at ");
            sb.append(path);
            sb.append(" (label ");
            sb.append(label);
            sb.append(")");
            log(sb);
            Memory.free(label);
            return true;
        }
        // 挂载点已占用（重复 label）等情况
        StrBuilder sb = new StrBuilder();
        sb.append("filesystem: mount ");
        sb.append(path);
        sb.append(" failed rc=");
        sb.append(StrUtils.toDec(rc));
        log(sb);
        Memory.free(label);
        return false;
    }

    /** 检查挂载点是否已挂载。 */
    private static boolean isMounted(str path) {
        int n = MountTable.getCount();
        for (int i = 0; i < n; i++) {
            if (StrUtils.equals(MountTable.getMountPath(i), path)) return true;
        }
        return false;
    }

    /** FAT32 卷标 → 挂载路径（fstab 语义）。 */
    private static str mountPathFor(str label) {
        if (StrUtils.equals(label, "ESP")) return "/";
        if (StrUtils.equals(label, "DATA")) return "/data";
        return null;
    }

    /** 打印挂载点内容（未挂载则静默）。 */
    private static void listMount(str path) {
        DEntry[] entries = VFS.ls(path);
        if (entries == null) return;
        for (int i = 0; i < entries.length; i++) {
            DEntry e = entries[i];
            if (e == null) continue;
            StrBuilder sb = new StrBuilder();
            sb.append("  ");
            sb.append(path);
            sb.append("/");
            sb.append(e.name);
            if (e.inode != null && e.inode.isDir()) sb.append("/");
            log(sb);
        }
        Memory.free((long) entries);
    }

    /** 读 /KERNEL.ELF 验证文件系统读取 + ELF 解析器。 */
    private static void verifyKernel() {
        int fd = VFS.open("/KERNEL.ELF", FileMode.READ);
        if (fd > 0) {
            byte[] hdr = new byte[16];
            int n = VFS.read(fd, hdr, 16);
            StrBuilder sb = new StrBuilder();
            sb.append("read /KERNEL.ELF: ");
            str ns = StrUtils.longToStr(n);
            sb.append(ns);
            Memory.free(ns);
            sb.append(" bytes, magic=");
            for (int i = 0; i < 4; i++) {
                str h = StrUtils.toHex((long) hdr[i] & 0xFFL);
                sb.append(h);
                Memory.free(h);
            }
            log(sb);
            Memory.free((long) hdr);
            VFS.close(fd);

            verifyKernelELF();
        } else {
            StartupLogger.error("open /KERNEL.ELF failed");
        }
    }

    /** 读整个 KERNEL.ELF 用 ELFLoader 解析，验证解析器（临时验证代码）。 */
    private static void verifyKernelELF() {
        INode kn = VFS.stat("/KERNEL.ELF");
        if (kn == null || !kn.isFile() || kn.size < 64 || kn.size > 8L * 1024 * 1024) {
            StartupLogger.error("elf verify: bad kernel file size");
            return;
        }
        int fsize = (int) kn.size;
        byte[] fbuf = new byte[fsize];
        int fd = VFS.open("/KERNEL.ELF", FileMode.READ);
        if (fd <= 0) {
            StartupLogger.error("elf verify: open failed");
            Memory.free((long) fbuf);
            return;
        }
        int total = 0;
        while (total < fsize) {
            int r = VFS.read(fd, fbuf, fsize - total);
            if (r <= 0) break;
            total += r;
        }
        VFS.close(fd);
        if (total != fsize) {
            StartupLogger.error("elf verify: short read");
            Memory.free((long) fbuf);
            return;
        }

        ELF elf = ELF.parse(fbuf);
        if (elf == null) {
            StartupLogger.error("elf verify: parse failed");
            Memory.free((long) fbuf);
            return;
        }

        StrBuilder sb = new StrBuilder();
        sb.append("elf verify: type=");
        sb.append(StrUtils.longToStr(elf.getType()));
        sb.append(" machine=");
        sb.append(StrUtils.longToStr(elf.getMachine()));
        sb.append(" entry=");
        sb.append(StrUtils.toHex(elf.getEntry()));
        sb.append(" segments=");
        sb.append(StrUtils.longToStr(elf.getSegments().length));
        sb.append(" sections=");
        sb.append(StrUtils.longToStr(elf.getSections().length));
        log(sb);

        ELFSegment[] segs = elf.getSegments();
        for (int i = 0; i < segs.length; i++) {
            if (segs[i] == null || !segs[i].isLoad()) continue;
            StrBuilder s2 = new StrBuilder();
            s2.append("elf seg[");
            s2.append(StrUtils.longToStr(i));
            s2.append("] vaddr=");
            s2.append(StrUtils.toHex(segs[i].vaddr));
            s2.append(" filesz=");
            s2.append(StrUtils.longToStr(segs[i].filesz));
            s2.append(" memsz=");
            s2.append(StrUtils.longToStr(segs[i].memsz));
            s2.append(" flags=");
            s2.append(StrUtils.longToStr(segs[i].flags));
            log(s2);
        }

        ELFSection text = elf.findSection(".text");
        if (text != null) {
            StrBuilder s3 = new StrBuilder();
            s3.append("elf .text addr=");
            s3.append(StrUtils.toHex(text.addr));
            s3.append(" size=");
            s3.append(StrUtils.longToStr(text.size));
            log(s3);
        } else {
            StartupLogger.warn("elf verify: .text not found");
        }

        Memory.free((long) fbuf);
    }

    private static void log(StrBuilder sb) {
        str msg = sb.build();
        StartupLogger.info(msg);
        Memory.free(msg);
        sb.dispose();
    }
}
