package kr.partix.kernel.main;

import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.additional.utils.StrUtils;
import lang.partic.stdlib.additional.utils.Optional;
import lang.partic.stdlib.core.memory.Memory;
import lang.partic.stdlib.core.exception.exception.Exception;
import kr.partix.kernel.arch.ArchRegistry;
import kr.partix.kernel.arch.IArch;
import kr.partix.kernel.io.pci.PCI;
import kr.partix.kernel.event.EventBus;
import kr.partix.kernel.event.EventId;
import kr.partix.kernel.event.eventlisteners.TestEventListener;
import kr.partix.kernel.event.eventlisteners.TimerEventListener;
import kr.partix.kernel.event.eventlisteners.UnknownInterruptEventListener;
import kr.partix.kernel.event.eventlisteners.NullPointerEventListener;
import kr.partix.kernel.memory.MemoryMap;
import kr.partix.kernel.device.BusType;
import kr.partix.kernel.device.DeviceRegistry;
import kr.partix.kernel.device.IDevice;
import kr.partix.kernel.io.drivers.DriverRegistry;
import kr.partix.kernel.io.drivers.display.virtio.VirtioGpuDriverTemplate;
import kr.partix.kernel.io.drivers.storage.ahci.AhciDriverTemplate;
import kr.partix.kernel.io.disk.DiskRegistry;
import kr.partix.kernel.io.disk.IDisk;
import kr.partix.kernel.fs.fat32.Fat32;
import kr.partix.kernel.fs.vfs.DEntry;
import kr.partix.kernel.fs.vfs.FileMode;
import kr.partix.kernel.fs.vfs.VFS;
import kr.partix.kernel.io.screen.IScreen;
import kr.partix.kernel.io.screen.ScreenRegistry;
import kr.partix.kernel.io.screen.UefiFramebufferScreen;
import kr.partix.kernel.io.drivers.display.gop.GopDevice;
import kr.partix.kernel.io.drivers.display.gop.UefiGopDriver;
import kr.partix.kernel.sys.System;
import kr.partix.kernel.io.screen.utils.ScreenUtils;
import kr.partix.kernel.io.screen.utils.RGB;
import kr.partix.kernel.utils.Point;

class BspKrMain {
    static IArch arch;

    /** 总线类型 → 展示名。 */
    private static str busName(int busType) {
        if (busType == BusType.PCI) return "pci";
        if (busType == BusType.PLATFORM) return "platform";
        return "dt";
    }

    static void main() {
        try {
            ArchRegistry.init();

            arch = System.getArch();

            EventBus.init();
            EventBus.registerEventListener(EventId.INTERRUPT_EVENT, new UnknownInterruptEventListener());
            EventBus.registerEventListener(EventId.TEST_EVENT, new TestEventListener());
            EventBus.registerEventListener(EventId.TIMER_EVENT, new TimerEventListener());
            EventBus.registerEventListener(EventId.TRIGGER_NULL_POINTER_EVENT, new NullPointerEventListener());

            MemoryMap.init();
            arch.getPageTableManager().init();
            arch.getPageTableManager().load();

            arch.init();

            StrBuilder strBuilder = new StrBuilder();
            strBuilder.append("Hello ");
            strBuilder.append(arch.getArchStr());
            strBuilder.append(" World!");

            str builded1 = strBuilder.build();
            arch.getUart().println(builded1);
            strBuilder.dispose();
            Memory.free(builded1);

            DriverRegistry.register(new VirtioGpuDriverTemplate());
            DriverRegistry.register(new AhciDriverTemplate());
            if (UefiFramebufferScreen.hasFramebuffer()) {
                DeviceRegistry.register(new GopDevice());
                DriverRegistry.register(new UefiGopDriver());
            }

            PCI.enumerate();
            ScreenRegistry.init();
            DiskRegistry.init();

            int devCount = DeviceRegistry.getCount();
            for (int i = 0; i < devCount; i++) {
                IDevice dev = DeviceRegistry.get(i);
                if (dev == null) continue;
                StrBuilder devSb = new StrBuilder();
                devSb.append("[dev] ");
                devSb.append(busName(dev.getBusType()));
                devSb.append(" ");
                devSb.append(dev.getName());
                str devLine = devSb.build();
                arch.getUart().println(devLine);
                devSb.dispose();
                Memory.free(devLine);
            }

            // 磁盘列表（驱动产物）
            int diskCount = DiskRegistry.getCount();
            for (int i = 0; i < diskCount; i++) {
                IDisk d = DiskRegistry.get(i);
                if (d == null) continue;
                StrBuilder diskSb = new StrBuilder();
                diskSb.append("[disk] ");
                diskSb.append(d.getName());
                diskSb.append(" sectors=");
                str sec = StrUtils.longToStr(d.getSectorCount());
                diskSb.append(sec);
                Memory.free(sec);
                str diskLine = diskSb.build();
                arch.getUart().println(diskLine);
                diskSb.dispose();
                Memory.free(diskLine);
            }

            // 文件系统：挂载第一块盘为 FAT32 根
            if (diskCount > 0) {
                IDisk disk0 = DiskRegistry.get(0);
                Fat32 fat = new Fat32(disk0);
                if (fat.isValid()) {
                    VFS.mount("/", disk0, fat);
                    DEntry[] entries = VFS.ls("/");
                    arch.getUart().println("[fs] mounted FAT32 at /");
                    for (int i = 0; i < entries.length; i++) {
                        DEntry e = entries[i];
                        if (e == null) continue;
                        StrBuilder fsSb = new StrBuilder();
                        fsSb.append("[fs]   ");
                        fsSb.append(e.name);
                        if (e.inode != null && e.inode.isDir()) fsSb.append("/");
                        str fsLine = fsSb.build();
                        arch.getUart().println(fsLine);
                        fsSb.dispose();
                        Memory.free(fsLine);
                    }
                    // 读 KERNEL.ELF 验证（ELF magic: 7F 45 4C 46）
                    int fd = VFS.open("/KERNEL.ELF", FileMode.READ);
                    if (fd > 0) {
                        byte[] hdr = new byte[16];
                        int n = VFS.read(fd, hdr, 16);
                        StrBuilder fsSb = new StrBuilder();
                        fsSb.append("[fs] /KERNEL.ELF read=");
                        str ns = StrUtils.toDec(n);
                        fsSb.append(ns);
                        Memory.free(ns);
                        fsSb.append(" first=");
                        str h0 = StrUtils.toHex((long) hdr[0] & 0xFFL);
                        fsSb.append(h0);
                        Memory.free(h0);
                        str h1 = StrUtils.toHex((long) hdr[1] & 0xFFL);
                        fsSb.append(h1);
                        Memory.free(h1);
                        str h2 = StrUtils.toHex((long) hdr[2] & 0xFFL);
                        fsSb.append(h2);
                        Memory.free(h2);
                        str h3 = StrUtils.toHex((long) hdr[3] & 0xFFL);
                        fsSb.append(h3);
                        Memory.free(h3);
                        str fsLine = fsSb.build();
                        arch.getUart().println(fsLine);
                        fsSb.dispose();
                        Memory.free(fsLine);
                        Memory.free((long) hdr);
                        VFS.close(fd);
                    } else {
                        arch.getUart().println("[fs] /KERNEL.ELF open failed");
                    }
                } else {
                    arch.getUart().println("[fs] no FAT32 on disk 0");
                }
            }

            Optional<IScreen> optScreen = ScreenRegistry.getPrimary();
            if (optScreen.isPresent()) {
                IScreen screen = optScreen.get();
                RGB clear = new RGB((byte) 0, (byte) 0, (byte) 0);
                ScreenUtils.fillRange(screen, 0, 0, screen.getWidth(), screen.getHeight(), clear);
                Point point = ScreenUtils.getCenter(screen);
                RGB rgb = new RGB((byte) 255, (byte) 0, (byte) 0);
                ScreenUtils.fill(screen, point.getX(), point.getY(), 5, 5, rgb);
                screen.flush(0, 0, screen.getWidth(), screen.getHeight());
                Memory.free((long) rgb);
                Memory.free((long) clear);
                Memory.free((long) point);
            } else {
                arch.getUart().println("[screen] no display, skipped");
            }
            Memory.free((long) optScreen);

            while (true) {}
        } catch (Exception e) {
            arch.getUart().println("!!! EXCEPTION !!!");

            while (true) {}
        }
    }
}
