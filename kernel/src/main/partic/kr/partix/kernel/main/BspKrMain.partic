package kr.partix.kernel.main;

import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.additional.utils.StrUtils;
import lang.partic.stdlib.additional.utils.Optional;
import lang.partic.stdlib.core.memory.Memory;
import lang.partic.stdlib.core.exception.exception.Exception;
import lang.partic.stdlib.core.exception.Throwable;
import kr.partix.kernel.arch.ArchRegistry;
import kr.partix.kernel.arch.IArch;
import kr.partix.kernel.main.inits.EventInit;
import kr.partix.kernel.memory.MemoryMap;
import kr.partix.kernel.memory.PageAllocator;
import kr.partix.kernel.io.screen.IScreen;
import kr.partix.kernel.io.screen.ScreenRegistry;
import kr.partix.kernel.sys.System;
import kr.partix.kernel.io.screen.utils.ScreenUtils;
import kr.partix.kernel.io.screen.utils.RGB;
import kr.partix.kernel.log.StartupLogger;
import kr.partix.kernel.debug.StackTrace;
import kr.partix.kernel.process.ProcessManager;
import kr.partix.kernel.sched.RoundRobinScheduler;
import kr.partix.kernel.sched.Scheduler;
import kr.partix.kernel.sched.Thread;

class BspKrMain {
    static IArch arch;

    static void main() {
        try {
            ArchRegistry.init();

            arch = System.getArch();

            EventInit.init();

            MemoryMap.init();
            PageAllocator.init();
            arch.getPageTableManager().init();
            arch.getPageTableManager().load();

            arch.init();

            StartupLogger.info("Welcome to Partix Kernel!");
            StartupLogger.info("Searching hardware informations...");

            StrBuilder strBuilder = new StrBuilder();
            strBuilder.append("Running on ");
            strBuilder.append(arch.getArchStr());
            strBuilder.append(" arch");
            str builded1 = strBuilder.build();
            StartupLogger.info(builded1);
            strBuilder.dispose();
            Memory.free(builded1);

            SystemInit.init();
            StartupLogger.info("---------------");
            StartupLogger.info("Start complete!");
            StartupLogger.info("---------------");
            StartupLogger.completed();

            Optional<IScreen> optScreen = ScreenRegistry.getPrimary();
            if (optScreen.isPresent()) {
                IScreen screen = optScreen.get();
                RGB clear = new RGB((byte) 0, (byte) 0, (byte) 0);
                ScreenUtils.fillRange(screen, 0, 0, screen.getWidth(), screen.getHeight(), clear);
                screen.flush(0, 0, screen.getWidth(), screen.getHeight());
                Memory.free((long) clear);
            } else {
                arch.getUart().println("[screen] no display, skipped");
            }
            Memory.free((long) optScreen);

            bootScheduler();
        } catch (Exception e) {
            arch.getUart().println("++++++++++++++++++");
            arch.getUart().println("!!! EXCEPTION !!!");
            StrBuilder sb = new StrBuilder();
            sb.append("Why: ");
            sb.append(e.getMessage());
            str builded = sb.build();
            arch.getUart().println(builded);
            Memory.free(builded);
            sb.dispose();

            StackTrace.printCurrent();

            int i = 1;
            Throwable whatNow = e;
            while (true) {
                if (whatNow.getCause() == null) break;
                whatNow = whatNow.getCause();
                for (int j = 0; j < i; j++) {
                    arch.getUart().print("  ");
                }
                StrBuilder sb1 = new StrBuilder();
                sb1.append("CauseMsg: ");
                sb1.append(whatNow.getMessage());
                str builded1 = sb1.build();
                arch.getUart().println(builded1);
                Memory.free(builded1);
                sb1.dispose();
                whatNow.dispose();
                i++;
            }
            e.dispose();
            arch.getUart().println("++++++++++++++++++");

            System.panic();

            while (true) {}
        }
    }

    /** 初始化调度器，起内核测试线程 + 内嵌用户程序，然后进入调度。 */
    private static void bootScheduler() {
        arch.getUart().println("[sched] init...");
        Scheduler.init(new RoundRobinScheduler());
        arch.getUart().println("[sched] init done");

        Thread kt1 = Scheduler.createKernelThread(new CountRunnable("A"));
        Scheduler.add(kt1);
        Thread kt2 = Scheduler.createKernelThread(new CountRunnable("B"));
        Scheduler.add(kt2);
        arch.getUart().println("[sched] kthreads ready");

        bootUserProgram();

        Scheduler.start();
    }

    /** 从磁盘加载 init 程序（/bin/init）并创建进程，作为第一个用户进程。 */
    private static void bootUserProgram() {
        // TODO 测试期临时加载 scrts 验证图形链路 完事改回 /bin/init
        arch.getUart().println("[user] loading /bin/scrts from disk...");
        long pid = ProcessManager.spawnFromPath("/bin/scrts");
        if (pid >= 0) {
            StrBuilder sb = new StrBuilder();
            sb.append("[user] scrts spawned, pid=");
            str pidStr = StrUtils.longToStr(pid);
            sb.append(pidStr);
            Memory.free(pidStr);
            str msg = sb.build();
            arch.getUart().println(msg);
            Memory.free(msg);
            sb.dispose();
        } else {
            arch.getUart().println("[user] /bin/scrts not found or invalid on disk");
        }
    }
}
