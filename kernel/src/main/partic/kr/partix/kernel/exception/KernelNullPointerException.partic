package kr.partix.kernel.exception;

import lang.partic.stdlib.core.exception.exception.RuntimeException;
import lang.partic.stdlib.core.exception.Throwable;

/**
 * 内核空指针异常
 */
class KernelNullPointerException extends RuntimeException {
    KernelNullPointerException(str message, Throwable cause) {
        super(message, cause);
    }
}
