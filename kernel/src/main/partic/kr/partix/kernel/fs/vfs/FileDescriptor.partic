package kr.partix.kernel.fs.vfs;

import kr.partix.kernel.fs.vfs.fileops.IFileOps;

class FileDescriptor {
    IFileOps ops;
    long position;
    int mode;
    long refCount;

    FileDescriptor(IFileOps ops, int mode) {
        this.ops = ops;
        this.position = 0L;
        this.mode = mode;
        this.refCount = 1L;
    }
}
