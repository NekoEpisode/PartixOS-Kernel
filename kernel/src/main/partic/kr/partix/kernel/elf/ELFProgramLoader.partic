package kr.partix.kernel.elf;

import kr.partix.kernel.main.BspKrMain;
import kr.partix.kernel.program.IProgram;
import kr.partix.kernel.program.IProgramLoader;
import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.additional.utils.StrUtils;

/**
 * ELF 程序加载器：magic 检测 + 用 ELF.parse 解析。
 */
class ELFProgramLoader implements IProgramLoader {
    boolean matches(byte[] data) ->
        data != null && data.length >= 4
        && data[0] == (byte) 0x7F && data[1] == (byte) 'E'
        && data[2] == (byte) 'L' && data[3] == (byte) 'F'

    IProgram load(byte[] data) {
        // 调试插桩：定位加载路径
        StrBuilder sb = new StrBuilder();
        sb.append("[dbg] elf.load enter len=");
        sb.append(StrUtils.longToStr(data.length));
        sb.append(" b0=");
        sb.append(StrUtils.toHex((long) (data[0] & 0xFF)));
        sb.append(" b1=");
        sb.append(StrUtils.toHex((long) (data[1] & 0xFF)));
        str out = sb.build();
        BspKrMain.arch.getUart().println(out);
        sb.dispose();
        ELF elf = ELF.parse(data);
        if (elf == null) {
            BspKrMain.arch.getUart().println("[dbg] elf.parse -> null");
            return null;
        }
        StrBuilder sb1 = new StrBuilder();
        sb1.append("[dbg] elf.parse -> entry=");
        sb1.append(StrUtils.toHex(elf.getEntry()));
        sb1.append(" machine=");
        sb1.append(StrUtils.longToStr((long) elf.getMachine()));
        str out1 = sb1.build();
        BspKrMain.arch.getUart().println(out1);
        sb1.dispose();
        return new ELFProgram(elf);
    }

    str getFormatName() -> "elf"
}
