package kr.partix.kernel.sys;

import kr.partix.kernel.arch.IArch;
import kr.partix.kernel.arch.ArchRegistry;

class System {
    extern short archId; // 0 for x86_64

    extern void write8(long addr, byte data);
    extern byte read8(long addr);
    extern void write16(long addr, short data);
    extern short read16(long addr);
    extern void write32(long addr, int data);
    extern int read32(long addr);
    extern void write64(long addr, long data);
    extern long read64(long addr);
    extern void halt();

    static IArch getArch() -> ArchRegistry.get(archId)
}
