package kr.partix.kernel.io.disk;

import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.core.memory.Memory;

/**
 * 磁盘分区视图：把父盘的一个区间包装成独立 IDisk。
 * 用于 GPT/MBR 分区挂载——文件系统看到的是从 0 开始的"子盘"。
 */
class PartitionDisk implements IDisk {
    private final IDisk parent;
    private final long startLba;
    private final long count;

    PartitionDisk(IDisk parent, long startLba, long count) {
        this.parent = parent;
        this.startLba = startLba;
        this.count = count;
    }

    /**
     * 解析 GPT，返回第一个非空分区；没有 GPT/分区时返回 null。
     * 只查第一个分区条目——当前镜像单分区。
     */
    static PartitionDisk findFirst(IDisk raw) {
        byte[] buf = new byte[512];
        if (raw.readSectors(1L, 1, buf) != 1) { Memory.free((long) buf); return null; }
        // GPT 头 magic: "EFI PART"
        if (buf[0] != (byte) 'E' || buf[1] != (byte) 'F' || buf[2] != (byte) 'I'
                || buf[3] != (byte) ' ' || buf[4] != (byte) 'P' || buf[5] != (byte) 'A'
                || buf[6] != (byte) 'R' || buf[7] != (byte) 'T') {
            Memory.free((long) buf);
            return null;
        }
        long partLba = readU64(buf, 72);   // PartitionEntryLBA
        int count = readU32(buf, 80);      // NumberOfPartitionEntries
        int entrySize = readU32(buf, 84);  // SizeOfPartitionEntry
        Memory.free((long) buf);
        if (count <= 0 || entrySize < 128) return null;

        byte[] entry = new byte[512];
        if (raw.readSectors(partLba, 1, entry) != 1) { Memory.free((long) entry); return null; }
        boolean empty = true;
        for (int i = 0; i < 128; i++) {
            if (entry[i] != (byte) 0) { empty = false; break; }
        }
        if (empty) { Memory.free((long) entry); return null; }
        long start = readU64(entry, 32);
        long end = readU64(entry, 40);
        Memory.free((long) entry);
        if (end < start) return null;
        return new PartitionDisk(raw, start, end - start + 1L);
    }

    private static int readU32(byte[] b, int off) {
        return (b[off] & 0xFF) | ((b[off + 1] & 0xFF) << 8)
                | ((b[off + 2] & 0xFF) << 16) | ((b[off + 3] & 0xFF) << 24);
    }

    private static long readU64(byte[] b, int off) {
        return ((long) readU32(b, off) & 0xFFFFFFFFL)
                | ((long) readU32(b, off + 4) << 32);
    }

    public int readSectors(long lba, int count, byte[] buf) {
        if (lba < 0 || lba + count > this.count) return -1;
        return parent.readSectors(lba + startLba, count, buf);
    }

    public int writeSectors(long lba, int count, byte[] buf) {
        if (lba < 0 || lba + count > this.count) return -1;
        return parent.writeSectors(lba + startLba, count, buf);
    }

    public long getSectorCount() -> count
    public int getSectorSize() -> parent.getSectorSize()

    public str getName() {
        StrBuilder sb = new StrBuilder();
        sb.append("part:");
        sb.append(parent.getName());
        str out = sb.build();
        sb.dispose();
        return out;
    }
}
