package kr.partix.kernel.memory;

import kr.partix.kernel.main.BspKrMain;
import kr.partix.kernel.sys.System;
import lang.partic.stdlib.additional.collection.list.ArrayList;
import lang.partic.stdlib.additional.collection.list.List;
import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.additional.utils.StrUtils;

class MemoryMapEntry {
    long start;
    long pages;
    int type;

    MemoryMapEntry(long start, long pages, int type) {
        this.start = start;
        this.pages = pages;
        this.type = type;
    }
}

class MemoryMap {
    private static long mmap;
    private static long mmapSize;
    private static long descSize;
    private static int descCount;

    private static List<MemoryMapEntry> freeRanges;
    private static long totalFreePages;

    static void init() {
        mmap = BootData.getMmapAddr();
        mmapSize = BootData.getMmapSize();
        descSize = BootData.getDescSize();

        descCount = (int)(mmapSize / descSize);
        // 诊断插桩（临时）：内存图头部信息
        StrBuilder mb = new StrBuilder();
        mb.append("[mmap] addr=");
        mb.append(StrUtils.toHex(mmap));
        mb.append(" size=");
        mb.append(StrUtils.longToStr(mmapSize));
        mb.append(" descSize=");
        mb.append(StrUtils.longToStr(descSize));
        mb.append(" count=");
        mb.append(StrUtils.longToStr((long) descCount));
        str mout = mb.build();
        BspKrMain.arch.getUart().println(mout);
        mb.dispose();
        for (int d = 0; d < descCount && d < 6; d++) {
            long base = mmap + (long)d * descSize;
            StrBuilder db = new StrBuilder();
            db.append("[mmap] d");
            db.append(StrUtils.longToStr((long) d));
            db.append(" type=");
            db.append(StrUtils.longToStr((long) System.read32(base)));
            db.append(" start=");
            db.append(StrUtils.toHex(System.read64(base + 8)));
            db.append(" pages=");
            db.append(StrUtils.longToStr(System.read64(base + 24)));
            str dout = db.build();
            BspKrMain.arch.getUart().println(dout);
            db.dispose();
        }

        freeRanges = new ArrayList<MemoryMapEntry>();
        totalFreePages = 0;

        for (int i = 0; i < descCount; i++) {
            long base = mmap + (long)i * descSize;
            int type = System.read32(base);
            long physStart = System.read64(base + 8);
            long pages = System.read64(base + 24);

            if (isFreeType(type) && pages > 0) {
                freeRanges.add(new MemoryMapEntry(physStart, pages, type));
                totalFreePages += pages;
            }
        }
    }

    static List<MemoryMapEntry> getFreeRanges() -> freeRanges
    static long getTotalFreePages() -> totalFreePages
    private static boolean isFreeType(int type) -> type == 7 || type == 3 || type == 4
}
