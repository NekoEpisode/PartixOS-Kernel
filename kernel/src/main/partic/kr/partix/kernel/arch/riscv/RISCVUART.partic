package kr.partix.kernel.arch.riscv;

import kr.partix.kernel.sys.System;
import kr.partix.kernel.io.uart.IUART;
import kr.partix.kernel.timer.Timer;

class RISCVUART implements IUART {
    private final long addr;

    RISCVUART(long addr) {
        this.addr = addr;
    }

    void print(char c) {
        print((byte) c);
    }

    void print(byte b) {
        // Wait for the transmitter to be ready (LSR bit5 = THRE).
        // Timeout (1 s) guards against a broken UART hanging the kernel;
        // on timeout the byte is dropped. Interrupts keep ticking meanwhile.
        long deadline = Timer.getTicks() + Timer.TICK_HZ;
        while ((System.read8(addr + 0x05) & 0x20) == 0) {
            if (Timer.getTicks() > deadline) return;
        }
        System.write8(addr, b);
    }

    void print(str s) {
        int i = 0;
        while (s[i] != (byte)0) {
            print(s[i]);
            i += 1;
        }
    }

    void println(str s) {
        print(s);
        print("\n");
    }

    long getAddr() -> addr
}
