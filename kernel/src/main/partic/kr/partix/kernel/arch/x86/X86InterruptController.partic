package kr.partix.kernel.arch.x86;

import kr.partix.kernel.sys.System;
import kr.partix.kernel.interrupt.IInterruptController;
import kr.partix.kernel.interrupt.IInterruptHandler;
import kr.partix.kernel.interrupt.IInterruptData;
import kr.partix.kernel.interrupt.Interrupt;
import kr.partix.kernel.exception.KernelNullPointerFault;
import kr.partix.kernel.boot.BootFail;
import kr.partix.kernel.sched.Scheduler;
import kr.partix.kernel.timer.Timer;
import kr.partix.kernel.syscall.Syscall;

class X86InterruptController implements IInterruptController {
    private static final int PIC1_CMD  = 0x20;
    private static final int PIC1_DATA = 0x21;
    private static final int PIC2_CMD  = 0xA0;
    private static final int PIC2_DATA = 0xA1;
    private static final int IRQ_BASE  = 0x20;
    private static final int PF_VECTOR = 14;
    private static final int SYSCALL_VECTOR = 0x80;

    private final IInterruptHandler[] handlers = new IInterruptHandler[256];
    private int pic1Mask;
    private int pic2Mask;

    private extern long paging_read_cr2();

    void init() {
        System.write8(PIC1_CMD, (byte) 0x11);
        System.write8(PIC1_DATA, (byte) IRQ_BASE);
        System.write8(PIC1_DATA, (byte) 0x04);
        System.write8(PIC1_DATA, (byte) 0x01);

        System.write8(PIC2_CMD, (byte) 0x11);
        System.write8(PIC2_DATA, (byte) (IRQ_BASE + 8));
        System.write8(PIC2_DATA, (byte) 0x02);
        System.write8(PIC2_DATA, (byte) 0x01);

        pic1Mask = 0xFF & ~(1 << 2);
        pic2Mask = 0xFF;
        System.write8(PIC1_DATA, (byte) pic1Mask);
        System.write8(PIC2_DATA, (byte) pic2Mask);

        // Local APIC timer (with automatic PIT fallback). The HAL keeps IRQ0
        // masked in APIC mode and unmasked when it falls back to PIT.
        Timer.init();

        System.enableInterrupts();
    }

    void registerHandler(int vector, IInterruptHandler handler) {
        handlers[vector] = handler;
    }

    void unregisterHandler(int vector) {
        handlers[vector] = null;
    }

    void enable(int vector) {
        if (vector < IRQ_BASE || vector >= IRQ_BASE + 16) return;
        int irq = vector - IRQ_BASE;
        if (irq < 8) {
            pic1Mask &= ~(1 << irq);
            System.write8(PIC1_DATA, (byte) pic1Mask);
        } else {
            pic2Mask &= ~(1 << (irq - 8));
            System.write8(PIC2_DATA, (byte) pic2Mask);
        }
    }

    void disable(int vector) {
        if (vector < IRQ_BASE || vector >= IRQ_BASE + 16) return;
        int irq = vector - IRQ_BASE;
        if (irq < 8) {
            pic1Mask |= (1 << irq);
            System.write8(PIC1_DATA, (byte) pic1Mask);
        } else {
            pic2Mask |= (1 << (irq - 8));
            System.write8(PIC2_DATA, (byte) pic2Mask);
        }
    }

    void eoi(int vector) {
        if (vector == Timer.getVector()) {
            Timer.eoi();
            return;
        }
        int irq = vector - IRQ_BASE;
        if (irq >= 0 && irq < 16) {
            System.write8(PIC1_CMD, (byte) 0x20);
            if (irq >= 8) System.write8(PIC2_CMD, (byte) 0x20);
        }
    }

    long dispatch(long cause, long epc, long sp, long frame) {
        int vector = (int) cause;

        // Page Fault：NULL 页 → NullPointer 事件；用户态其他缺页 → 杀线程；
        // 内核态其他缺页 → 内核映射缺失，停机。
        if (vector == PF_VECTOR) {
            long cr2 = paging_read_cr2();
            if (cr2 < 4096) {
                KernelNullPointerFault.trigger(cr2, epc, 0);
                return 0;
            }
            // 帧 +144 = CS：RPL 位判断 fault 发生在用户态还是内核态
            long cs = System.read64(frame + 144);
            if ((cs & 3) != 0) {
                // 用户态缺页（如访问未映射用户页）→ 终止当前用户线程
                Scheduler.sysExit(-11);
                return Scheduler.onReschedule();
            }
            BootFail.fail("kernel page fault");
            return 0;
        }

        if (vector == Timer.getVector()) {
            // Timer interrupt — bump g_tick, run the scheduler tick, then
            // notify via TimerEvent. Returns the next frame to restore.
            Timer.tick();
            long next = Scheduler.onTick();
            Interrupt.fireTimerEvent(epc, sp);
            Timer.eoi();
            return next;
        }

        if (vector == SYSCALL_VECTOR) {
            // 用户态 syscall（syscall_entry 构建的帧，rax=号，args 见帧槽）：
            //   rax=+112, rdi=+72, rsi=+80, rdx=+88, r10=+40, r8=+48, r9=+56
            long num = System.read64(frame + 112);
            long a0 = System.read64(frame + 72);
            long a1 = System.read64(frame + 80);
            long a2 = System.read64(frame + 88);
            long a3 = System.read64(frame + 40);
            long a4 = System.read64(frame + 48);
            long a5 = System.read64(frame + 56);
            long ret = Syscall.dispatch((int) num, a0, a1, a2, a3, a4, a5);
            System.write64(frame + 112, ret);
            return Scheduler.onReschedule();
        }

        IInterruptHandler h = handlers[vector];
        IInterruptData data = null;
        if (h != null) {
            h.handle(vector, data);
            eoi(vector);
            return 0;
        }
        // 无 handler 的中断才进事件系统（UnknownInterruptEventListener 报日志）。
        // 之前无条件 fire，导致已处理的 IRQ1（PS/2 键盘）也打 "unhandled"。
        Interrupt.fire(vector, epc, sp, data);
        eoi(vector);
        return 0;
    }
}
