package kr.partix.kernel.arch.x86;

import kr.partix.kernel.sys.System;
import kr.partix.kernel.io.uart.IUART;

class X86UART implements IUART {
    private static final long UART_ADDR = 0x3F8;

    void print(char c) {
        print((byte) c);
    }

    void print(byte b) {
        System.write8(UART_ADDR, b);
    }

    void print(str s) {
        int i = 0;
        while (s[i] != (byte)0) {
            print(s[i]);
            i += 1;
        }
    }

    void println(str s) {
        print(s);
        print("\n");
    }
}
