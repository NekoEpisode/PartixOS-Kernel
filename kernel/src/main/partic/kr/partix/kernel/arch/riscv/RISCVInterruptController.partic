package kr.partix.kernel.arch.riscv;

import kr.partix.kernel.sys.System;
import kr.partix.kernel.boot.BootFail;
import kr.partix.kernel.interrupt.IInterruptController;
import kr.partix.kernel.interrupt.IInterruptHandler;
import kr.partix.kernel.interrupt.Interrupt;
import kr.partix.kernel.exception.KernelNullPointerFault;
import kr.partix.kernel.sched.Scheduler;
import kr.partix.kernel.syscall.Syscall;
import kr.partix.kernel.timer.Timer;

class RISCVInterruptController implements IInterruptController {
    private static long plicBase;

    // PLIC context 1 = hart0 S-mode (kernel runs in S-mode over OpenSBI).
    private static final long PLIC_CTX_ENABLE_BASE = 0x2080;
    private static final long PLIC_CTX_THRESHOLD   = 0x201000;
    private static final long PLIC_CTX_CLAIM       = 0x201004;

    // scause decoding: bit 63 marks an interrupt; low bits give the code.
    private static final long SCAUSE_INTERRUPT = 0x8000000000000000L;
    private static final long SCAUSE_CODE      = 0x7FFFFFFFFFFFFFFFL;
    private static final long CAUSE_SSI = 1;   // supervisor software interrupt
    private static final long CAUSE_STI = 5;   // supervisor timer interrupt
    private static final long CAUSE_SEI = 7;   // supervisor external interrupt
    private static final long CAUSE_ECALL_U = 8; // ecall from U-mode

    // trap 帧布局（context.S / entry.S）：a7 在 +120，a0~a5 在 +64~+104
    private static final long FRAME_A0 = 64;
    private static final long FRAME_A5 = 104;
    private static final long FRAME_A7 = 120;
    private static final long FRAME_SSTATUS = 248;

    private static final long SSTATUS_SPP = 0x100;

    private final IInterruptHandler[] handlers = new IInterruptHandler[256];

    private boolean plicReady = false;

    private extern long fdt_get_plic_base();
    private extern long paging_read_stval();

    void init() {
        plicBase = fdt_get_plic_base();
        if (plicBase == 0) {
            // PLIC 是外部中断底座，地址必须来自设备树；缺失 = 环境不完整。
            BootFail.fail("no PLIC base (device tree unavailable)");
        }
        ensurePlic();
        // UEFI/OpenSBI may leave a pending supervisor software interrupt;
        // clear it before interrupts open so it cannot fire once sie.SSIE is on.
        Timer.clearSsi();
        if (Timer.init() != 0) {
            // 时基频率必须来自设备树（timebase-frequency）；缺失时定时器无法
            // 正确工作，报 BOOT FAILED 而不是带错频率跑。
            BootFail.fail("timer init failed (no timebase-frequency in device tree)");
        }
        System.enableInterrupts();
    }

    private void ensurePlic() {
        if (plicReady) return;
        for (long i = 1; i < 64; i++) {
            writeEnable(i, false);
        }
        writeThreshold(0);
        plicReady = true;
    }

    void registerHandler(int vector, IInterruptHandler handler) {
        handlers[vector] = handler;
    }

    void unregisterHandler(int vector) {
        handlers[vector] = null;
    }

    void enable(int vector) {
        ensurePlic();
        writeEnable(vector, true);
        writePriority(vector, 1);
    }

    void disable(int vector) {
        writeEnable(vector, false);
    }

    void eoi(int vector) {
        System.write32(plicBase + PLIC_CTX_CLAIM, vector);
    }

    long dispatch(long cause, long epc, long sp, long frame) {
        boolean isInterrupt = (cause & SCAUSE_INTERRUPT) != 0;
        long code = cause & SCAUSE_CODE;

        if (isInterrupt) {
            if (code == CAUSE_STI) {
                // Supervisor timer interrupt (ACLINT/CLINT via SBI TIME).
                Timer.tick();
                long next = Scheduler.onTick();
                Interrupt.fireTimerEvent(epc, sp);
                Timer.eoi();
                return next;
            }
            if (code == CAUSE_SEI) {
                // Supervisor external interrupt: claim the PLIC source.
                int irq = System.read32(plicBase + PLIC_CTX_CLAIM);
                IInterruptHandler h = handlers[irq];
                if (h != null) h.handle(irq, null);
                Interrupt.fire(irq, epc, sp, null);
                System.write32(plicBase + PLIC_CTX_CLAIM, irq);
                return 0;
            }
            if (code == CAUSE_SSI) {
                // Supervisor software interrupt (IPI). No sender is wired up
                // yet; clear the pending bit and ignore so it cannot storm.
                Timer.clearSsi();
                return 0;
            }
            // Unknown interrupt cause — report it.
            Interrupt.fire((int) code, epc, sp, null);
            return 0;
        }

        if (code == CAUSE_ECALL_U) {
            // 用户态系统调用：a7 = 号，a0~a5 = 参数
            long num = System.read64(frame + FRAME_A7);
            long a0 = System.read64(frame + FRAME_A0);
            long a1 = System.read64(frame + FRAME_A0 + 8);
            long a2 = System.read64(frame + FRAME_A0 + 16);
            long a3 = System.read64(frame + FRAME_A0 + 24);
            long a4 = System.read64(frame + FRAME_A0 + 32);
            long a5 = System.read64(frame + FRAME_A5);
            long ret = Syscall.dispatch((int) num, a0, a1, a2, a3, a4, a5);
            System.write64(frame + FRAME_A0, ret);
            // sepc 前进到下一条指令，避免 sret 后重执行 ecall
            System.write64(frame + 240, epc + 4);
            return Scheduler.onReschedule();
        }

        // 页/访问类异常（12=取指缺页, 13/15=load/store 缺页, 5/7=访问异常）
        if (code == 12 || code == 13 || code == 15 || code == 5 || code == 7) {
            long stval = paging_read_stval();
            long sstatus = System.read64(frame + FRAME_SSTATUS);
            boolean user = (sstatus & SSTATUS_SPP) == 0;
            if (user) {
                // 用户态故障：杀掉当前线程，不 panic
                Scheduler.sysExit(-11);
                return Scheduler.onReschedule();
            }
            if (stval < 4096) {
                KernelNullPointerFault.trigger(stval, epc, frame);
                return 0;
            }
            // 内核态其他地址的缺页：说明内核自身映射缺失，停机
            BootFail.fail("kernel page fault");
        }

        // Synchronous exception — report with the exception code as vector.
        int vector = (int) code;
        IInterruptHandler h = handlers[vector];
        if (h != null) h.handle(vector, null);
        Interrupt.fire(vector, epc, sp, null);
        return 0;
    }

    private static void writeEnable(long src, boolean on) {
        long offset = PLIC_CTX_ENABLE_BASE + (src / 32) * 4;
        int bit = (int)(src % 32);
        int val = System.read32(plicBase + offset);
        if (on) val |= (1 << bit);
        else    val &= ~(1 << bit);
        System.write32(plicBase + offset, val);
    }

    private static void writePriority(long src, int prio) {
        System.write32(plicBase + src * 4, prio);
    }
    private static void writeThreshold(int thresh) {
        System.write32(plicBase + PLIC_CTX_THRESHOLD, thresh);
    }
}
