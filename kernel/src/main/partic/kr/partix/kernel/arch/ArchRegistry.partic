package kr.partix.kernel.arch;

import kr.partix.kernel.sys.System;
import kr.partix.kernel.exception.IllegalArgumentException;

class ArchRegistry {
    private static final IArch[] arches = new IArch[1024];

    static void init() {
        // 只创建当前运行架构的实例
        short archId = System.archId;
        if (archId == 0) {
            register(new X86Arch());
        } else if (archId == 1) {
            register(new RISCVArch());
        } else {
            throw new IllegalArgumentException("Unknown arch id", null);
        }
    }

    static void register(IArch arch) {
        short archId = arch.getArchId();
        if (archId > 1024) {
            throw new IllegalArgumentException("Invaild arch id (> 1024)", null);
        }
        arches[archId] = arch;
    }

    static IArch get(short id) {
        if (id > 1024) {
            throw new IllegalArgumentException("Invaild arch id (> 1024)", null);
        }
        return arches[id];
    }
}
