package kr.partix.kernel.arch.riscv;

import kr.partix.kernel.sys.System;
import lang.partic.stdlib.core.memory.Memory;
import kr.partix.kernel.memory.BootData;
import kr.partix.kernel.memory.MemoryLayout;
import kr.partix.kernel.paging.IPageTableManager;
import kr.partix.kernel.paging.PageFlags;

/**
 * RISC-V（SV39）页表管理器。
 *
 * 内核根页表只含 physmap（KERNEL_PHYS_BASE + phys，2MB 大页，pgd 槽 256 起）：
 * 内核高半区运行，低地址（identity）不再映射——用户空间独占低区（bit38=0），
 * 内核高区（bit38=1）经 physmap 访问物理内存，二者在虚拟地址上隔离。
 *
 * SV39 PTE：表项内容为物理地址（ppn 字段，>>2 存储）；表指针本身是堆 VA。
 * 写入表项用 virtToPhys()，从表项取下一级表指针用 physToVirt()，satp 用物理。
 * 叶子判断：R|W|X 任一置位即叶子（QEMU cpu_helper.c 同规则）。
 */
class RISCVPageTableManager implements IPageTableManager {
    private extern void paging_load_satp(long satp);
    private extern void paging_flush_tlb();

    // UEFI GOP framebuffer（C 侧全局变量，hal/riscv64/kernel_entry.c）
    private extern long gop_framebuffer;
    private extern long gop_stride;
    private extern long gop_height;

    private static final long PTE_V = 1;
    private static final long PTE_R = 2;
    private static final long PTE_W = 4;
    private static final long PTE_X = 8;
    private static final long PTE_U = 16;
    private static final long PTE_A = 64;
    private static final long PTE_D = 128;

    private static final long SATP_MODE_SV39 = 8L << 60;
    /** PTE 中物理地址（PPN）字段掩码（bit 9:0 为标志位）。 */
    private static final long PTE_ADDR_MASK = ~0x3FFL;

    private long pgd;
    private long activeRoot = -1;

    private static long allocZeroPage() {
        long addr = Memory.malloc(8192);
        addr = (addr + 4095) & ~4095;
        for (int i = 0; i < 512; i++) {
            System.write64(addr + (long)i * 8, 0);
        }
        return addr;
    }

    void init() {
        pgd = allocZeroPage();
        buildKernelMap();
    }

    /**
     * 内核根页表：physmap（KERNEL_PHYS_BASE + phys，2MB 大页，pgd 槽 256 起）。
     * 覆盖低 4GB 物理（实际 RAM + 常见 MMIO：UART/PLIC/ECAM/DWMMC 均在此范围）。
     */
    private void buildKernelMap() {
        long maxPhys = findMaxPhys();
        if (maxPhys == 0) return;
        if (maxPhys < 0x100000000L) maxPhys = 0x100000000L;

        int pmdCount = (int)((maxPhys + 0x3FFFFFFF) / 0x40000000);
        if (pmdCount < 1) pmdCount = 1;
        if (pmdCount > 255) pmdCount = 255;   // 内核区 256GB 上限内

        int pmSlot = 256;   // SV39 内核区 pgd 槽起点（bit38=1）
        for (int gb = 0; gb < pmdCount; gb++) {
            long pmd = allocZeroPage();
            System.write64(pgd + (long)(pmSlot + gb) * 8,
                    (MemoryLayout.virtToPhys(pmd) >> 2) | PTE_V);

            for (int mb = 0; mb < 512; mb++) {
                long phys = (long)gb * 0x40000000 + (long)mb * 0x200000;
                if (phys > maxPhys) break;
                long entry = (phys >> 2) | PTE_V | PTE_R | PTE_W | PTE_X | PTE_A | PTE_D;
                System.write64(pmd + (long)mb * 8, entry);
            }
        }
    }

    void map(long virt, long phys, long size, int flags) {
        long entry = (phys >> 2);
        entry |= PTE_V | PTE_A | PTE_D;
        if ((flags & PageFlags.WRITABLE) != 0) entry |= PTE_W;
        if ((flags & PageFlags.NO_EXEC) == 0) entry |= PTE_X;
        if ((flags & PageFlags.USER) != 0) entry |= PTE_U;

        int pmdIndex = (int)(virt / 0x40000000);
        int mbIndex = (int)((virt % 0x40000000) / 0x200000);

        long pgdEntry = System.read64(pgd + (long)pmdIndex * 8);
        long pmd = MemoryLayout.physToVirt((pgdEntry & PTE_ADDR_MASK) << 2);
        System.write64(pmd + (long)mbIndex * 8, entry);
        paging_flush_tlb();
    }

    /** 把 [phys, phys+size) 映射进 physmap（SV39 内核区，2MB 页，向上取整）。 */
    void mapPhys(long phys, long size, int flags) {
        long start = phys & ~0x1FFFFFL;
        long end = (phys + size + 0x1FFFFFL) & ~0x1FFFFFL;
        for (long p = start; p < end; p += 0x200000L) {
            mapPhys2m(p, flags);
        }
        paging_flush_tlb();
    }

    /** 映射 physmap 内一个 2MB 页；中间表按需分配。 */
    private void mapPhys2m(long phys, int flags) {
        long va = MemoryLayout.kernelPhysBase() + phys;
        int pgdIndex = (int) ((va >>> 30) & 0x1FF);
        int pmdIndex = (int) ((va >>> 21) & 0x1FF);

        long entry = (phys >> 2) | PTE_V | PTE_R | PTE_W | PTE_A | PTE_D;
        if ((flags & PageFlags.NO_EXEC) != 0) entry &= ~PTE_X;

        long pgdEntry = System.read64(pgd + (long) pgdIndex * 8);
        long pmd;
        if ((pgdEntry & PTE_V) == 0) {
            pmd = allocZeroPage();
            System.write64(pgd + (long) pgdIndex * 8,
                    (MemoryLayout.virtToPhys(pmd) >> 2) | PTE_V);
        } else {
            pmd = MemoryLayout.physToVirt((pgdEntry & PTE_ADDR_MASK) << 2);
        }

        System.write64(pmd + (long) pmdIndex * 8, entry);
    }

    void load() {
        long satp = SATP_MODE_SV39 | (MemoryLayout.virtToPhys(pgd) >> 12);
        paging_load_satp(satp);
        activeRoot = pgd;
    }

    long getKernelRoot() -> pgd

    long createAddressSpace() {
        long root = allocZeroPage();
        // 克隆内核 pgd 槽（physmap：256 起，为每个在用槽分配 pmd 表并拷贝）。
        for (int i = 0; i < 512; i++) {
            long pgdEntry = System.read64(pgd + (long)i * 8);
            if (pgdEntry == 0) continue;
            long srcPmd = MemoryLayout.physToVirt((pgdEntry & PTE_ADDR_MASK) << 2);
            long dstPmd = allocZeroPage();
            for (int j = 0; j < 512; j++) {
                System.write64(dstPmd + (long)j * 8, System.read64(srcPmd + (long)j * 8));
            }
            System.write64(root + (long)i * 8,
                    (MemoryLayout.virtToPhys(dstPmd) >> 2) | (pgdEntry & 0x3FFL));
        }
        return root;
    }

    void map4k(long root, long virt, long phys, int flags) {
        long entry = (phys >> 2) | PTE_V | PTE_R | PTE_A | PTE_D;
        if ((flags & PageFlags.WRITABLE) != 0) entry |= PTE_W;
        if ((flags & PageFlags.NO_EXEC) == 0) entry |= PTE_X;
        if ((flags & PageFlags.USER) != 0) entry |= PTE_U;

        int pgdIndex = (int)(virt / 0x40000000L);
        int pmdIndex = (int)((virt % 0x40000000L) / 0x200000L);
        int pteIndex = (int)((virt % 0x200000L) / 0x1000L);

        long pgdEntry = System.read64(root + (long)pgdIndex * 8);
        long pmd;
        if ((pgdEntry & PTE_V) == 0) {
            pmd = allocZeroPage();
            System.write64(root + (long)pgdIndex * 8,
                    (MemoryLayout.virtToPhys(pmd) >> 2) | PTE_V);
        } else {
            pmd = MemoryLayout.physToVirt((pgdEntry & PTE_ADDR_MASK) << 2);
        }

        long pmdEntry = System.read64(pmd + (long)pmdIndex * 8);
        long pteTable;
        if ((pmdEntry & PTE_V) == 0) {
            pteTable = allocZeroPage();
            System.write64(pmd + (long)pmdIndex * 8,
                    (MemoryLayout.virtToPhys(pteTable) >> 2) | PTE_V);
        } else if ((pmdEntry & (PTE_R | PTE_W | PTE_X)) != 0) {
            // 2MB 叶子大页 → 拆成 4KB PTE 表，保留原有映射
            pteTable = allocZeroPage();
            long physBase = (pmdEntry >> 10) << 12;
            long baseFlags = pmdEntry & 0x3FFL;
            for (int i = 0; i < 512; i++) {
                System.write64(pteTable + (long)i * 8,
                        ((physBase + (long)i * 4096) >> 2) | baseFlags);
            }
            System.write64(pmd + (long)pmdIndex * 8,
                    (MemoryLayout.virtToPhys(pteTable) >> 2) | PTE_V);
        } else {
            pteTable = MemoryLayout.physToVirt((pmdEntry & PTE_ADDR_MASK) << 2);
        }

        System.write64(pteTable + (long)pteIndex * 8, entry);
        paging_flush_tlb();
    }

    void unmap4k(long root, long virt) {
        int pgdIndex = (int)(virt / 0x40000000L);
        int pmdIndex = (int)((virt % 0x40000000L) / 0x200000L);
        int pteIndex = (int)((virt % 0x200000L) / 0x1000L);

        long pgdEntry = System.read64(root + (long)pgdIndex * 8);
        if ((pgdEntry & PTE_V) == 0) return;
        long pmd = MemoryLayout.physToVirt((pgdEntry & PTE_ADDR_MASK) << 2);
        long pmdEntry = System.read64(pmd + (long)pmdIndex * 8);
        if ((pmdEntry & PTE_V) == 0) return;
        if ((pmdEntry & (PTE_R | PTE_W | PTE_X)) != 0) return;  // 2MB 大页，不按 4KB 拆
        long pteTable = MemoryLayout.physToVirt((pmdEntry & PTE_ADDR_MASK) << 2);
        System.write64(pteTable + (long)pteIndex * 8, 0);
        paging_flush_tlb();
    }

    void loadRoot(long root) {
        if (root == activeRoot) return;
        long satp = SATP_MODE_SV39 | (MemoryLayout.virtToPhys(root) >> 12);
        paging_load_satp(satp);
        activeRoot = root;
    }

    private long findMaxPhys() {
        long max = 0;
        long descSize = BootData.getDescSize();
        int count = (int)(BootData.getMmapSize() / descSize);
        long mmapV = MemoryLayout.physToVirt(BootData.getMmapAddr());

        for (int i = 0; i < count; i++) {
            long base = mmapV + (long)i * descSize;
            long physStart = System.read64(base + 8);
            long pages = System.read64(base + 24);
            long end = physStart + pages * 4096;
            if (end > max) max = end;
        }
        return max;
    }

    /** GOP framebuffer 物理地址上限（gop_framebuffer + size）；无 GOP 返回 0。 */
    private static long gopFbEnd() {
        long fb = gop_framebuffer;
        if (fb == 0) return 0;
        long stride = gop_stride;
        long h = gop_height;
        if (stride == 0 || h == 0) return fb + 0x100000;  // 保守 1MB
        return fb + stride * h;
    }
}
