package kr.partix.kernel.arch;

import kr.partix.kernel.arch.riscv.RISCVUART;
import kr.partix.kernel.io.uart.IUART;
import kr.partix.kernel.io.pci.IPCIIO;
import kr.partix.kernel.arch.riscv.RISCVPCIIO;
import kr.partix.kernel.interrupt.IInterruptController;
import kr.partix.kernel.arch.riscv.RISCVInterruptController;
import kr.partix.kernel.paging.IPageTableManager;
import kr.partix.kernel.arch.riscv.RISCVPageTableManager;
import kr.partix.kernel.sys.System;
import kr.partix.kernel.timer.Timer;
import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.core.memory.Memory;

class RISCVArch implements IArch {
    private final IUART uart;
    private final IPCIIO pciIo;
    private final RISCVInterruptController ic;
    private final RISCVPageTableManager ptm;

    private extern long fdt_get_uart_base();
    private extern long fdt_get_pcie_base();

    RISCVArch() {
        uart = new RISCVUART(fdt_get_uart_base());
        pciIo = new RISCVPCIIO(fdt_get_pcie_base());
        ic = new RISCVInterruptController();
        ptm = new RISCVPageTableManager();
    }

    void init() {
        uart.println("[dbg] arch.init");
        ic.init();
        uart.println("[dbg] ic.init done");
        long sbiErr = Timer.getSbiError();
        if (sbiErr != 0) {
            // SBI set_timer failed — the timer will never fire.
            // SBI error codes: -1 failed, -2 not supported, -3 invalid param...
            StrBuilder sb = new StrBuilder();
            sb.append("[timer] SBI set_timer failed, err=");
            sb.appendLong(sbiErr);
            str out = sb.build();
            uart.println(out);
            Memory.free(out);
            sb.dispose();
        }
    }

    short getArchId() -> (short) 1
    str getArchStr() -> "RISC-V"
    IUART getUart() -> uart
    IPCIIO getPciIo() -> pciIo
    IInterruptController getInterruptController() -> ic
    IPageTableManager getPageTableManager() -> ptm

    void panic() {
        uart.println("KERNEL PANIC!");
        while (true) {
            System.stopInterrupts();
            System.halt();
        }
        // TODO: 输出调试信息，保存内核堆栈，寄存器
    }
}
