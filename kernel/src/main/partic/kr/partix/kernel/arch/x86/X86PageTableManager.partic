package kr.partix.kernel.arch.x86;

import kr.partix.kernel.sys.System;
import lang.partic.stdlib.core.memory.Memory;
import kr.partix.kernel.memory.BootData;
import kr.partix.kernel.paging.IPageTableManager;
import kr.partix.kernel.paging.PageFlags;

class X86PageTableManager implements IPageTableManager {
    private extern void paging_load_cr3(long cr3);

    private static final long PML4E_PRESENT  = 1;
    private static final long PML4E_RW       = 2;
    private static final long PDE_PS_2MB     = 0x80;
    private static final long PDE_NX         = 0x8000000000000000L;

    private long pml4;

    private static long allocZeroPage() {
        long addr = Memory.malloc(8192);
        addr = (addr + 4095) & ~4095;
        for (int i = 0; i < 512; i++) {
            System.write64(addr + (long)i * 8, 0);
        }
        return addr;
    }

    void init() {
        pml4 = allocZeroPage();
        buildIdentityMap();
        protectNullPage();
    }

    private void buildIdentityMap() {
        long maxPhys = findMaxPhys();
        if (maxPhys == 0) return;
        if (maxPhys < 0x10000000000L) maxPhys = 0x10000000000L;

        int pdCount = (int)((maxPhys + 0x3FFFFFFF) / 0x40000000);
        if (pdCount < 1) pdCount = 1;

        int pdptCount = (pdCount + 511) / 512;

        for (int pi = 0; pi < pdptCount; pi++) {
            long pdpt = allocZeroPage();
            System.write64(pml4 + (long)pi * 8, pdpt | PML4E_PRESENT | PML4E_RW);

            int gbStart = pi * 512;
            int gbEnd = (pi + 1) * 512;
            if (gbEnd > pdCount) gbEnd = pdCount;

            for (int gb = gbStart; gb < gbEnd; gb++) {
                long pd = allocZeroPage();
                int slot = gb - gbStart;
                System.write64(pdpt + (long)slot * 8, pd | PML4E_PRESENT | PML4E_RW);

                for (int mb = 0; mb < 512; mb++) {
                    long phys = (long)gb * 0x40000000 + (long)mb * 0x200000;
                    if (phys > maxPhys) break;
                    long entry = phys | PML4E_PRESENT | PML4E_RW | PDE_PS_2MB;
                    System.write64(pd + (long)mb * 8, entry);
                }
            }
        }
    }

    void map(long virt, long phys, long size, int flags) {
        long entry = phys | PML4E_PRESENT | PDE_PS_2MB;
        if ((flags & PageFlags.WRITABLE) != 0) entry |= PML4E_RW;
        if ((flags & PageFlags.NO_EXEC) != 0) entry |= PDE_NX;

        int pdIndex = (int)(virt / 0x40000000);
        int mbIndex = (int)((virt % 0x40000000) / 0x200000);

        long pdBase = System.read64(pml4) & ~0xFFF;
        long pd = System.read64(pdBase + (long)pdIndex * 8) & ~0xFFF;
        System.write64(pd + (long)mbIndex * 8, entry);
    }

    void load() {
        paging_load_cr3(pml4);
    }

    private long findMaxPhys() {
        long max = 0;
        long descSize = BootData.getDescSize();
        int count = (int)(BootData.getMmapSize() / descSize);

        for (int i = 0; i < count; i++) {
            long base = BootData.getMmapAddr() + (long)i * descSize;
            long physStart = System.read64(base + 8);
            long pages = System.read64(base + 24);
            long end = physStart + pages * 4096;
            if (end > max) max = end;
        }
        return max;
    }

    /**
     * 把第一 2MB 大页（0x0-0x200000）拆成 4KB 页，0x0-0xFFF 不可访问。
     * 空指针访问（读/写地址 0）将触发 Page Fault（#PF），由
     * X86InterruptController 转换为 KernelNullPointerException。
     */
    private void protectNullPage() {
        long pdpt = System.read64(pml4) & 0xFFFFFFFFFFFFF000L;
        long pd = System.read64(pdpt) & 0xFFFFFFFFFFFFF000L;
        long pteTable = allocZeroPage();
        // pd[0]：从 2MB 大页项改为指向 4KB pte 表（去掉 PS 位）
        System.write64(pd, (pteTable & 0xFFFFFFFFFFFFF000L) | PML4E_PRESENT | PML4E_RW);
        for (int i = 1; i < 512; i++) {
            long phys = (long)i * 4096;
            System.write64(pteTable + (long)i * 8, phys | PML4E_PRESENT | PML4E_RW);
        }
        // pte[0] 保持 0（allocZeroPage 清零）→ 0x0-0xFFF 不可访问
    }
}
