package kr.partix.kernel.arch.x86;

import kr.partix.kernel.sys.System;
import lang.partic.stdlib.core.memory.Memory;
import kr.partix.kernel.memory.BootData;
import kr.partix.kernel.memory.MemoryLayout;
import kr.partix.kernel.paging.IPageTableManager;
import kr.partix.kernel.paging.PageFlags;

/**
 * x86-64 页表管理器。
 *
 * 内核根页表只含 physmap（KERNEL_PHYS_BASE + phys，2MB 大页，PML4[256] 起）：
 * 内核高半区运行，低地址（identity）不再映射——内核访问物理内存一律经
 * physmap 转换（physToVirt），未映射地址访问直接 #PF（空指针页 0 天然不可访问）。
 *
 * 页表本身分配自内核堆（VA），但页表项内容必须是物理地址：
 * 写入表项用 virtToPhys()，从表项取下一级表指针用 physToVirt()，
 * CR3 装载用 virtToPhys(root)。
 */
class X86PageTableManager implements IPageTableManager {
    private extern void paging_load_cr3(long cr3);
    private extern void paging_flush_tlb();

    private static final long PML4E_PRESENT  = 1;
    private static final long PML4E_RW       = 2;
    private static final long PDE_PS_2MB     = 0x80;
    private static final long PDE_NX         = 0x8000000000000000L;
    private static final long ADDR_MASK      = 0x000FFFFFFFFFF000L;

    private long pml4;
    private long activeRoot = -1;

    private static long allocZeroPage() {
        long addr = Memory.malloc(8192);
        addr = (addr + 4095) & ~4095;
        for (int i = 0; i < 512; i++) {
            System.write64(addr + (long)i * 8, 0);
        }
        return addr;
    }

    void init() {
        pml4 = allocZeroPage();
        buildKernelMap();
    }

    /**
     * 内核根页表：physmap（KERNEL_PHYS_BASE + phys，2MB 大页，PML4[256] 起）。
     * 覆盖低 4GB 物理（实际 RAM + 常见 MMIO：PCI hole 0xE0000000+、APIC、
     * framebuffer）；更大的 MMIO 窗口后续按需扩展。
     */
    private void buildKernelMap() {
        long maxPhys = findMaxPhys();
        if (maxPhys == 0) return;
        if (maxPhys < 0x100000000L) maxPhys = 0x100000000L;

        int pdCount = (int)((maxPhys + 0x3FFFFFFF) / 0x40000000);
        if (pdCount < 1) pdCount = 1;
        if (pdCount > 512) pdCount = 512;

        int pdptCount = (pdCount + 511) / 512;

        int pmSlot = 256;
        for (int pi = 0; pi < pdptCount; pi++) {
            long pdpt = allocZeroPage();
            System.write64(pml4 + (long)(pmSlot + pi) * 8,
                    MemoryLayout.virtToPhys(pdpt) | PML4E_PRESENT | PML4E_RW);

            int gbStart = pi * 512;
            int gbEnd = (pi + 1) * 512;
            if (gbEnd > pdCount) gbEnd = pdCount;

            for (int gb = gbStart; gb < gbEnd; gb++) {
                long pd = allocZeroPage();
                int slot = gb - gbStart;
                System.write64(pdpt + (long)slot * 8,
                        MemoryLayout.virtToPhys(pd) | PML4E_PRESENT | PML4E_RW);

                for (int mb = 0; mb < 512; mb++) {
                    long phys = (long)gb * 0x40000000 + (long)mb * 0x200000;
                    if (phys > maxPhys) break;
                    long entry = phys | PML4E_PRESENT | PML4E_RW | PDE_PS_2MB;
                    System.write64(pd + (long)mb * 8, entry);
                }
            }
        }
    }

    void map(long virt, long phys, long size, int flags) {
        long entry = phys | PML4E_PRESENT | PDE_PS_2MB;
        if ((flags & PageFlags.WRITABLE) != 0) entry |= PML4E_RW;
        if ((flags & PageFlags.NO_EXEC) != 0) entry |= PDE_NX;

        int pdIndex = (int)(virt / 0x40000000);
        int mbIndex = (int)((virt % 0x40000000) / 0x200000);

        long pdBase = MemoryLayout.physToVirt(System.read64(pml4) & ADDR_MASK);
        long pd = MemoryLayout.physToVirt(System.read64(pdBase + (long)pdIndex * 8) & ADDR_MASK);
        System.write64(pd + (long)mbIndex * 8, entry);
        paging_flush_tlb();
    }

    void load() {
        paging_load_cr3(MemoryLayout.virtToPhys(pml4));
        activeRoot = pml4;
    }

    long getKernelRoot() -> pml4

    long createAddressSpace() {
        long root = allocZeroPage();
        // 克隆内核 PML4 槽：深拷贝 PDPT + PD（大页叶子原样共享）。
        for (int i = 0; i < 512; i++) {
            long pml4e = System.read64(pml4 + (long)i * 8);
            if ((pml4e & PML4E_PRESENT) == 0) continue;
            long srcPdpt = MemoryLayout.physToVirt(pml4e & ADDR_MASK);
            long dstPdpt = allocZeroPage();
            for (int j = 0; j < 512; j++) {
                long pdpte = System.read64(srcPdpt + (long)j * 8);
                if ((pdpte & PML4E_PRESENT) == 0) continue;
                if ((pdpte & PDE_PS_2MB) != 0) {
                    System.write64(dstPdpt + (long)j * 8, pdpte);
                    continue;
                }
                long srcPd = MemoryLayout.physToVirt(pdpte & ADDR_MASK);
                long dstPd = allocZeroPage();
                for (int k = 0; k < 512; k++) {
                    System.write64(dstPd + (long)k * 8, System.read64(srcPd + (long)k * 8));
                }
                System.write64(dstPdpt + (long)j * 8,
                        MemoryLayout.virtToPhys(dstPd) | (pdpte & 0xFFFL));
            }
            System.write64(root + (long)i * 8,
                    MemoryLayout.virtToPhys(dstPdpt) | (pml4e & 0xFFFL));
        }
        return root;
    }

    void map4k(long root, long virt, long phys, int flags) {
        long entry = phys | PML4E_PRESENT;
        if ((flags & PageFlags.WRITABLE) != 0) entry |= PML4E_RW;
        if ((flags & PageFlags.USER) != 0) entry |= 4;      // US 位
        if ((flags & PageFlags.NO_EXEC) != 0) entry |= PDE_NX;
        // x86-64 的 U/S 位是逐级 AND 的：用户访问要求 PML4E/PDPTE/PDE/PTE
        // 每一级都有 US 位（QEMU excp_helper.c ptep &= pte ^ PG_NX_MASK）。
        // 用户页必须把路径上各级都标 US，否则任何一级 U/S=0 → #PF。
        long pathUser = (flags & PageFlags.USER) != 0 ? 4 : 0;

        int pml4Index = (int)(virt / 0x8000000000L);
        int pdptIndex = (int)((virt % 0x8000000000L) / 0x40000000L);
        int pdIndex = (int)((virt % 0x40000000L) / 0x200000L);
        int ptIndex = (int)((virt % 0x200000L) / 0x1000L);

        long pml4e = System.read64(root + (long)pml4Index * 8);
        long pdpt;
        if ((pml4e & PML4E_PRESENT) == 0) {
            pdpt = allocZeroPage();
            System.write64(root + (long)pml4Index * 8,
                    MemoryLayout.virtToPhys(pdpt) | PML4E_PRESENT | PML4E_RW | pathUser);
        } else {
            pdpt = MemoryLayout.physToVirt(pml4e & ADDR_MASK);
            if (pathUser != 0 && (pml4e & 4) == 0) {
                System.write64(root + (long)pml4Index * 8, pml4e | 4);
            }
        }

        long pdpte = System.read64(pdpt + (long)pdptIndex * 8);
        long pd;
        if ((pdpte & PML4E_PRESENT) == 0) {
            pd = allocZeroPage();
            System.write64(pdpt + (long)pdptIndex * 8,
                    MemoryLayout.virtToPhys(pd) | PML4E_PRESENT | PML4E_RW | pathUser);
        } else {
            pd = MemoryLayout.physToVirt(pdpte & ADDR_MASK);
            if (pathUser != 0 && (pdpte & 4) == 0) {
                System.write64(pdpt + (long)pdptIndex * 8, pdpte | 4);
            }
        }

        long pde = System.read64(pd + (long)pdIndex * 8);
        long pt;
        if ((pde & PML4E_PRESENT) != 0 && (pde & PDE_PS_2MB) != 0) {
            // 2MB 叶子 → 拆成 4KB PTE 表，保留原有映射
            pt = allocZeroPage();
            long physBase = pde & ADDR_MASK;
            long baseFlags = pde & 0xFFFL;
            for (int i = 0; i < 512; i++) {
                System.write64(pt + (long)i * 8,
                        (physBase + (long)i * 4096) | (baseFlags & ~PDE_PS_2MB));
            }
            System.write64(pd + (long)pdIndex * 8,
                    MemoryLayout.virtToPhys(pt) | PML4E_PRESENT | PML4E_RW | pathUser);
        } else if ((pde & PML4E_PRESENT) != 0) {
            pt = MemoryLayout.physToVirt(pde & ADDR_MASK);
            if (pathUser != 0 && (pde & 4) == 0) {
                System.write64(pd + (long)pdIndex * 8, pde | 4);
            }
        } else {
            pt = allocZeroPage();
            System.write64(pd + (long)pdIndex * 8,
                    MemoryLayout.virtToPhys(pt) | PML4E_PRESENT | PML4E_RW | pathUser);
        }

        System.write64(pt + (long)ptIndex * 8, entry);
        paging_flush_tlb();
    }

    void unmap4k(long root, long virt) {
        int pml4Index = (int)(virt / 0x8000000000L);
        int pdptIndex = (int)((virt % 0x8000000000L) / 0x40000000L);
        int pdIndex = (int)((virt % 0x40000000L) / 0x200000L);
        int ptIndex = (int)((virt % 0x200000L) / 0x1000L);

        long pml4e = System.read64(root + (long)pml4Index * 8);
        if ((pml4e & PML4E_PRESENT) == 0) return;
        long pdpt = MemoryLayout.physToVirt(pml4e & ADDR_MASK);
        long pdpte = System.read64(pdpt + (long)pdptIndex * 8);
        if ((pdpte & PML4E_PRESENT) == 0) return;
        long pd = MemoryLayout.physToVirt(pdpte & ADDR_MASK);
        long pde = System.read64(pd + (long)pdIndex * 8);
        if ((pde & PML4E_PRESENT) == 0) return;
        if ((pde & PDE_PS_2MB) != 0) return;   // 2MB 大页，不按 4KB 拆
        long pt = MemoryLayout.physToVirt(pde & ADDR_MASK);
        System.write64(pt + (long)ptIndex * 8, 0);
        paging_flush_tlb();
    }

    void loadRoot(long root) {
        if (root == activeRoot) return;
        paging_load_cr3(MemoryLayout.virtToPhys(root));
        activeRoot = root;
    }

    private long findMaxPhys() {
        long max = 0;
        long descSize = BootData.getDescSize();
        int count = (int)(BootData.getMmapSize() / descSize);
        long mmapV = MemoryLayout.physToVirt(BootData.getMmapAddr());

        for (int i = 0; i < count; i++) {
            long base = mmapV + (long)i * descSize;
            long physStart = System.read64(base + 8);
            long pages = System.read64(base + 24);
            long end = physStart + pages * 4096;
            if (end > max) max = end;
        }
        return max;
    }
}
