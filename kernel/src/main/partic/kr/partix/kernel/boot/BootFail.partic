package kr.partix.kernel.boot;

import kr.partix.kernel.sys.System;

/**
 * BOOT FAILED：平台环境不完整时终止启动
 */
class BootFail {
    private extern void sbi_console_putchar(byte c);

    static void fail(str reason) {
        printStr("[BOOT FAILED] ");
        printStr(reason);
        printStr("\n");
        System.stopInterrupts();
        while (true) {
            System.halt();
        }
    }

    private static void printStr(str s) {
        int i = 0;
        while (s[i] != (byte) 0) {
            sbi_console_putchar(s[i]);
            i += 1;
        }
    }
}
