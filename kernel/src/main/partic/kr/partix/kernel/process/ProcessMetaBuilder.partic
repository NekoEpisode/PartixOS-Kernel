package kr.partix.kernel.process;

import kr.partix.kernel.program.IProgram;

class ProcessMetaBuilder {
    private str name = "unknown";
    private IProgram program;
    private byte[] data;

    ProcessMetaBuilder() {}

    void name(str name) {
        this.name = name;
    }

    void program(IProgram program) {
        this.program = program;
    }

    void data(byte[] data) {
        this.data = data;
    }

    ProcessMeta build() -> new ProcessMeta(name, program, data)
}
