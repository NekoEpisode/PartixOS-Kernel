package kr.partix.kernel.syscall;

import kr.partix.kernel.io.screen.IScreen;
import kr.partix.kernel.io.screen.ScreenRegistry;
import kr.partix.kernel.paging.AddressSpace;
import kr.partix.kernel.process.Process;
import kr.partix.kernel.sched.Scheduler;
import kr.partix.kernel.sched.Thread;
import kr.partix.kernel.sys.System;
import kr.partix.kernel.main.BspKrMain;
import kr.partix.kernel.memory.MemoryLayout;
import lang.partic.stdlib.additional.utils.StrBuilder;
import lang.partic.stdlib.additional.utils.StrUtils;
import lang.partic.stdlib.core.memory.Memory;

/**
 * fbinfo(screenId, buf)：写 4 个 long 到 buf：w h stride fb_addr
 * fb_addr 是 framebuffer 映射到当前进程用户空间的虚拟地址
 * 首次访问某屏时懒映射（AddressSpace.mapScreen）
 */
class SysFbinfo implements ISyscallHandler {
    long handle(long a0, long a1, long a2, long a3, long a4, long a5) {
        int id = (int) a0;
        if (a1 == 0) return -1;
        if (id < 0 || id >= ScreenRegistry.getScreenCount()) return -1;
        IScreen screen = ScreenRegistry.getScreen(id);
        if (screen == null) return -1;

        Thread t = Scheduler.current();
        if (t == null || t.owner() == null) return -1;
        Process owner = t.owner();
        AddressSpace as = owner.addressSpace();
        if (as == null) return -1;

        // getFramebuffer() 返回 VA（供读写）；mapScreen 的 PTE 需要物理地址
        long fbPhys = MemoryLayout.virtToPhys((long) screen.getFramebuffer());
        long fbSize = screen.getFramebufferSize();
        long fbAddr = as.mapScreen(id, fbPhys, fbSize);
        if (fbAddr < 0) return -1;

        // 调试：打印 framebuffer 物理地址/大小/映射页数
        long pages = (fbSize + 4095L) / 4096L;
        StrBuilder sb = new StrBuilder();
        sb.append("[fbinfo] id=");
        str ids = StrUtils.longToStr(id);
        sb.append(ids);
        Memory.free(ids);
        sb.append(" phys=");
        sb.append(StrUtils.toHex(fbPhys));
        sb.append(" size=");
        str sz = StrUtils.longToStr(fbSize);
        sb.append(sz);
        Memory.free(sz);
        sb.append(" pages=");
        str pg = StrUtils.longToStr(pages);
        sb.append(pg);
        Memory.free(pg);
        str msg = sb.build();
        BspKrMain.arch.getUart().println(msg);
        Memory.free(msg);
        sb.dispose();

        System.write64(a1, screen.getWidth());
        System.write64(a1 + 8, screen.getHeight());
        System.write64(a1 + 16, screen.getStride());
        System.write64(a1 + 24, fbAddr);
        return 0;
    }
}
