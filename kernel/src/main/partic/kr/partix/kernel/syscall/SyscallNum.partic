package kr.partix.kernel.syscall;

class SyscallNum {
    static final int EXIT = 0;
    static final int WRITE = 1;
    static final int YIELD = 2;
    static final int SLEEP = 3;
    static final int GETTID = 4;
    static final int OPEN = 5;
    static final int READ = 6;
    static final int CLOSE = 7;
    static final int SPAWN = 8;
    static final int WAIT = 9;
    static final int GETCWD = 10;
    static final int CHDIR = 11;
    static final int SCREEN_COUNT = 12;
    static final int FBINFO = 13;
    static final int FLIP = 14;
    static final int PIPE = 15;
    static final int DUP2 = 16;
    static final int SPAWN_REDIR = 17;
}
