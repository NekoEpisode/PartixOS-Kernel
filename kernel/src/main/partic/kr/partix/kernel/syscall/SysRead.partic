package kr.partix.kernel.syscall;

import kr.partix.kernel.fs.vfs.VFS;
import kr.partix.kernel.sys.System;
import lang.partic.stdlib.core.memory.Memory;

/** read(fd, buf, len)：从文件描述符读入用户态缓冲区，返回实际字节数。 */
class SysRead implements ISyscallHandler {
    long handle(long a0, long a1, long a2, long a3, long a4, long a5) {
        if (a2 <= 0 || a2 > 4096) return -1;
        int len = (int) a2;
        byte[] buf = new byte[len];
        int n = VFS.read((int) a0, buf, len);
        if (n > 0) {
            for (int i = 0; i < n; i++) {
                System.write8(a1 + i, (byte) buf[i]);
            }
        }
        Memory.free((long) buf);
        return (long) n;
    }
}
