package kr.partix.kernel.syscall;

import kr.partix.kernel.fs.vfs.FileDescriptor;
import kr.partix.kernel.fs.vfs.FileMode;
import kr.partix.kernel.process.Process;
import kr.partix.kernel.sched.Scheduler;
import kr.partix.kernel.sched.Thread;
import kr.partix.kernel.sys.System;
import lang.partic.stdlib.core.memory.Memory;

/** write(fd, buf, len)：写入进程 fd 表对应文件描述符。 */
class SysWrite implements ISyscallHandler {
    long handle(long a0, long a1, long a2, long a3, long a4, long a5) {
        if (a2 <= 0 || a2 > 4096) return -1;
        Thread t = Scheduler.current();
        if (t == null || t.owner() == null) return -1;
        Process owner = t.owner();
        FileDescriptor desc = owner.getFd((int) a0);
        if (desc == null || desc.ops == null) return (long) FileMode.ERR_BAD_FD;
        if ((desc.mode & FileMode.WRITE) == 0) return (long) FileMode.ERR_BAD_FD;

        int len = (int) a2;
        byte[] buf = new byte[len];
        for (int i = 0; i < len; i++) {
            buf[i] = (byte) System.read8(a1 + i);
        }
        int n = desc.ops.write(desc, buf, len);
        Memory.free((long) buf);
        return (long) n;
    }
}
